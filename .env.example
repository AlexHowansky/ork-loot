# Copy to .env and adjust. Bun loads .env automatically.

# --- Server ---------------------------------------------------------------

# "production" turns on JSON logs and Secure cookies, and turns off dev mode.
# `bun run start` sets it for you.
NODE_ENV=development

# Port the server listens on.
PORT=3000

# debug, info, warn or error.
LOG_LEVEL=info

# Set to 1 to mark cookies Secure outside production, e.g. when testing
# behind HTTPS. Production always marks them Secure.
SECURE_COOKIES=0

# --- Storage --------------------------------------------------------------

# SQLite database file. Defaults to data/app.db.
DB_PATH=data/app.db

# Where uploaded campaign images are kept. Defaults to data/uploads.
UPLOAD_DIR=data/uploads

# --- Mail -----------------------------------------------------------------

# The app's public address, used to build links in emails. No trailing
# slash needed. Defaults to http://localhost:$PORT.
APP_URL=http://localhost:3000

# Outgoing mail server. Leave SMTP_HOST empty to write emails to the server
# log instead of sending them.
SMTP_HOST=smtp.example.com
# Mail is only ever sent over TLS. 465 and 2465 use TLS from the start; any
# other port (587, 2587) must offer STARTTLS or nothing is sent.
SMTP_PORT=587
SMTP_USER=postmaster@example.com
SMTP_PASS=change-me
# Defaults to "Phat Loot <noreply@HOST>", where HOST comes from APP_URL.
SMTP_FROM="Phat Loot <noreply@example.com>"

# --- CLI ------------------------------------------------------------------

# Password for `bun run gm create|passwd`, skipping the prompt. Meant for
# scripts; left commented out because, if set here, every create and passwd
# would silently use it.
# GM_PASSWORD=correct-horse-battery-staple
